# TMDB API key (required; used only on the server)
API_KEY=

# RapidAPI key for the IMDb rating (optional; used only on the server)
RAPIDAPI_KEY=

# Provider API base URLs (server-only; do not include credentials)
TMDB_API_BASE_URL=https://api.themoviedb.org
IMDB_API_BASE_URL=https://imdb8.p.rapidapi.com

# Public URLs are visible to browsers and are embedded at build time.
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_YOUTUBE_EMBED_BASE_URL=https://www.youtube.com/embed
